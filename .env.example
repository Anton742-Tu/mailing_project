# ==================================================
# Django Settings - Настройки Django
# ==================================================

# Режим отладки (True для разработки, False для продакшена)
DEBUG=True

# Секретный ключ Django (обязательно измените в продакшене!)
SECRET_KEY=django-insecure-замените-этот-ключ-на-очень-длинный-случайный-секрет

# Разрешенные хосты (через запятую без пробелов)
ALLOWED_HOSTS=localhost,127.0.0.1,ваш-домен.ру

# ==================================================
# Database Settings - Настройки PostgreSQL
# ==================================================

# Имя базы данных
DB_NAME=mailing_db

# Пользователь базы данных
DB_USER=mailing_user

# Пароль базы данных (обязательно измените!)
DB_PASSWORD=ваш-надежный-пароль-для-бд

# Хост базы данных
DB_HOST=localhost

# Порт базы данных
DB_PORT=5432

# ==================================================
# Email Settings - Настройки почты
# ==================================================

# SMTP сервер
EMAIL_HOST=smtp.gmail.com

# Порт SMTP
EMAIL_PORT=587

# Email для отправки рассылок
EMAIL_HOST_USER=your-email@gmail.com

# Пароль приложения (не пароль от email!)
EMAIL_HOST_PASSWORD=ваш-пароль-приложения
